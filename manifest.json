{
    "name": "eeClass 助手",
    "version": "1.0",
    "manifest_version": 3,
    "description": "把 eeClass 變得更好用",
    "icons": {
        "16": "icons/logo16x16.png",
        "32": "icons/logo32x32.png",
        "36": "icons/logo36x36.png",
        "48": "icons/logo48x48.png",
        "128": "icons/logo128x128.png"
    },
    "permissions": [
        "alarms", "notifications"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://eeclass.nthu.edu.tw/*",
                "https://oauth.ccxp.nthu.edu.tw/v1.1/authorize.php*"
            ],
            "js": [
                "thirdParty/jquery-3.7.1.min.js",
                "thirdParty/moment.min.js",
                "thirdParty/zh-tw.min.js",
                "functions/oauth.js",
                "functions/eeclass.js",
                "inject.js"
            ]
        }
    ]
}
